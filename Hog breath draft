const kickers = [
[301,"Brandon Aubrey","DAL","K","",0.0,"",15],
[302,"Ka'imi Fairbairn","HOU","K","",0.0,"",15],
[303,"Cameron Dicker","LAC","K","",0.0,"",15],
[304,"Cam Little","JAX","K","",0.0,"",15],
[305,"Jason Myers","SEA","K","",0.0,"",15]
];

const all = [...players, ...defenses, ...kickers];

// ---- Draft slot math ----
const TEAMS = 12;
const MY_SLOT = 2; // 1.02

// ---- Scoring-adjusted rank ----
// Each entry: [rank, name, team, pos, flag, adj, tag, recRound]
// Skill positions (QB/RB/WR/TE) have real consensus overall ADP in `rank`, so adj (rounds earlier/later)
// meaningfully re-sorts them and produces a genuine market-vs-adjusted delta.
// DEF/K don't have a real combined-board ADP to diff against — those use an explicitly assigned
// recommended round instead, and never generate a "target" delta badge.
const SKILL_POS = new Set(['QB','RB','WR','TE']);
const skillPlayers = all.filter(p => SKILL_POS.has(p[3]));
skillPlayers.forEach(p => { p.adjRound = (p[0] / TEAMS) + p[5]; p.hasDelta = true; });
const byAdj = [...skillPlayers].sort((a,b) => a.adjRound - b.adjRound);
byAdj.forEach((p,i) => { p.adjRank = i+1; });
skillPlayers.forEach(p => { p.delta = p[0] - p.adjRank; });

const nonSkill = all.filter(p => !SKILL_POS.has(p[3]));
nonSkill.forEach(p => { p.adjRound = p[7]; p.hasDelta = false; p.delta = 0; p.adjRank = null; });
function overallToRoundPick(overall){
  const round = Math.ceil(overall / TEAMS);
  const idxInRound = overall - (round-1)*TEAMS; // 1..12, position within round order as picked
  return {round, idxInRound};
}
function slotOnClock(overall){
  const {round, idxInRound} = overallToRoundPick(overall);
  // odd rounds: slot = idxInRound ; even rounds: slot = TEAMS+1-idxInRound
  return (round % 2 === 1) ? idxInRound : (TEAMS+1-idxInRound);
}
function nextMyPickOverall(fromOverall){
  let o = fromOverall;
  while(slotOnClock(o) !== MY_SLOT){ o++; if(o>500) break; }
  return o;
}

// ---- State ----
// GITHUB PAGES BUILD: uses localStorage directly, since this runs in a normal top-level
// browser tab (not a sandboxed artifact iframe) where localStorage is fully reliable —
// same pattern as your existing SuperCoach checklist app.
const STORAGE_KEY = 'hogmarket_draft_state_v1';
let state = {}; // name -> 'mine' | 'other'
let storageBroken = false; // flips true after first failed save — stops retry spam, shows manual backup path

async function loadState(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    if(raw){ state = JSON.parse(raw); }
  }catch(e){ /* nothing saved yet, or storage unavailable (e.g. private browsing) — start fresh */ }
}
async function saveState(){
  if(storageBroken) return; // already know it's failing, don't keep hammering it
  try{
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  }catch(e){
    storageBroken = true;
    const w = document.getElementById('storageWarning');
    if(w) w.style.display = 'block';
  }
}

// Swallow noisy cross-origin "Script error." events from the storage bridge —
// state itself is already safe in memory, this just stops console spam.
window.addEventListener('error', (e)=>{ e.preventDefault(); }, true);
window.addEventListener('unhandledrejection', (e)=>{ e.preventDefault(); }, true);

// ---- Manual backup / restore (works regardless of storage bridge status) ----
function encodeState(){
  return btoa(unescape(encodeURIComponent(JSON.stringify(state))));
}
function decodeState(str){
  return JSON.parse(decodeURIComponent(escape(atob(str.trim()))));
}

let currentFilter = 'ALL';
let searchTerm = '';
let sortMode = 'MARKET'; // MARKET | ADJ | STEALS
let hideDrafted = true; // default on — shrinks the list as the draft progresses
let lastAction = null; // {name, prev} — for the Undo button

function posColor(pos){
  return {QB:'var(--qb)',RB:'var(--rb)',WR:'var(--wr)',TE:'var(--te)',DEF:'var(--def)',K:'var(--k)'}[pos] || 'var(--muted)';
}

function deltaBadge(p){
  if(!p.hasDelta) return '';
  const d = p.delta;
  if(d >= 1) return `<span class="flag" style="background:#123822;color:#4ADE80;">▲${d} TARGET</span>`;
  if(d <= -1) return `<span class="flag" style="background:#2a1414;color:#FF8A8A;">▼${Math.abs(d)}</span>`;
  return '';
}

function renderInner(){
  // scoreboard
  const draftedCount = Object.keys(state).length;
  const overall = draftedCount + 1;
  const {round} = overallToRoundPick(overall);
  document.getElementById('overallPickNum').textContent = overall;
  document.getElementById('roundNum').textContent = round;

  const onClock = slotOnClock(overall) === MY_SLOT;
  const badge = document.getElementById('pickBadge');
  const waitingEl = document.getElementById('clockMsgWaiting');
  const onClockEl = document.getElementById('clockMsgOnClock');
  if(onClock){
    badge.classList.add('on-clock');
    waitingEl.style.display = 'none';
    onClockEl.style.display = 'inline';
  } else {
    badge.classList.remove('on-clock');
    onClockEl.style.display = 'none';
    waitingEl.style.display = 'inline';
    const nxt = nextMyPickOverall(overall);
    document.getElementById('untilClock').textContent = nxt - overall;
  }

  // last pick by me
  const mine = Object.entries(state).filter(([k,v])=>v==='mine').map(([k])=>k);
  document.getElementById('lastYourPick').textContent = mine.length ? mine[mine.length-1] : '—';
  document.getElementById('undoWrap').style.display = lastAction ? 'inline' : 'none';

  // roster panel
  renderRoster();

  // list
  const listEl = document.getElementById('list');
  listEl.innerHTML = '';
  let pool = all;
  if(currentFilter === 'MINE'){
    pool = all.filter(p => state[p[1]] === 'mine');
  } else if(currentFilter !== 'ALL'){
    pool = all.filter(p => p[3] === currentFilter);
  }
  if(searchTerm){
    const t = searchTerm.toLowerCase();
    pool = pool.filter(p => p[1].toLowerCase().includes(t) || p[2].toLowerCase().includes(t));
  }

  let hiddenCount = 0;
  if(hideDrafted && currentFilter !== 'MINE'){
    const beforeCount = pool.length;
    pool = pool.filter(p => !state[p[1]]);
    hiddenCount = beforeCount - pool.length;
  }
  const countNote = document.getElementById('hiddenCountNote');
  countNote.textContent = hiddenCount > 0 ? `${hiddenCount} drafted players hidden` : '';

  let emptyMsg = '';
  if(sortMode === 'ADJ'){
    pool = [...pool].sort((a,b)=>a.adjRound-b.adjRound);
  } else if(sortMode === 'STEALS'){
    pool = pool.filter(p => p.hasDelta && p.delta >= 1 && !state[p[1]]).sort((a,b)=>b.delta-a.delta);
    if(pool.length === 0) emptyMsg = 'No live targets right now — nothing left on the board is graded meaningfully ahead of its market slot for this format. (DEF/K don\'t have a real market ADP to compare against, so they never show here — check the DEF/K filter tabs for those instead.)';
  } else {
    pool = [...pool].sort((a,b)=>a[0]-b[0]);
  }

  if(emptyMsg){
    const note = document.createElement('div');
    note.className = 'section-note';
    note.textContent = emptyMsg;
    listEl.appendChild(note);
  }

  pool.forEach(p=>{
    const [rank,name,team,pos,flag,adj,tag,recRound] = p;
    const st = state[name];
    const row = document.createElement('div');
    row.className = 'row' + (st==='other' ? ' gone' : '') + (st==='mine' ? ' mine' : '');
    let leadNum, subRank;
    if(sortMode === 'MARKET'){
      leadNum = p.hasDelta ? rank : `R${recRound}`;
      subRank = '';
    } else if(p.hasDelta){
      leadNum = p.adjRank;
      subRank = `<span style="color:var(--muted); font-size:10px;">mkt #${rank}</span>`;
    } else {
      leadNum = `R${recRound}`;
      subRank = `<span style="color:var(--muted); font-size:10px;">target round</span>`;
    }
    row.innerHTML = `
      <div class="rank mono" style="width:34px; flex:0 0 34px;">${leadNum}</div>
      <div class="pos-pill" style="background:${posColor(pos)}22; color:${posColor(pos)};">${pos}</div>
      <div class="pinfo">
        <div class="pname ${st==='other'?'gone-strike':''}">${name}${flag==='HOLDIN'?'<span class="flag holdin">HOLD-IN</span>':''}${flag==='INJURY'?'<span class="flag injury">INJURY</span>':''}${deltaBadge(p)}</div>
        <div class="pteam">${team} ${subRank} ${tag?`<span style="color:var(--muted);">· ${tag}</span>`:''}</div>
      </div>
      <button class="mine-btn ${st==='mine'?'active':''}" data-name="${name.replace(/"/g,'&quot;')}">${st==='mine' ? '✅ MINE' : 'MINE'}</button>
    `;
    // Tap the row body = drafted by someone else (the common case — ~11 of every 12 picks).
    // Tap again on an already-'other' row = undo back to available.
    row.addEventListener('click', (e)=>{
      if(e.target.closest('.mine-btn')) return; // handled by its own listener below
      if(!state[name]){ state[name] = 'other'; }
      else if(state[name]==='other'){ delete state[name]; }
      else { state[name] = 'other'; } // was 'mine' by mistake — correct it
      lastAction = {name, prev: st};
      saveState();
      render();
    });
    listEl.appendChild(row);
  });

  // Wire up MINE buttons separately — deliberate, distinct tap target for your own picks only.
  listEl.querySelectorAll('.mine-btn').forEach(btn=>{
    btn.addEventListener('click', (e)=>{
      e.stopPropagation();
      const name = btn.dataset.name;
      const prev = state[name];
      if(state[name] === 'mine'){ delete state[name]; } // undo
      else { state[name] = 'mine'; } // correct from 'other' or set fresh
      lastAction = {name, prev};
      saveState();
      render();
    });
  });
}

function render(){
  try{
    renderInner();
    const banner = document.getElementById('renderErrorBanner');
    if(banner) banner.style.display = 'none';
  }catch(e){
    console.error('render failed', e);
    let banner = document.getElementById('renderErrorBanner');
    if(!banner){
      banner = document.createElement('div');
      banner.id = 'renderErrorBanner';
      banner.style.cssText = 'margin:10px 14px; padding:10px 12px; background:#3A1414; border:1px solid #5A2323; border-radius:8px; font-size:12px; color:#FF8A8A;';
      document.body.insertBefore(banner, document.getElementById('list'));
    }
    banner.textContent = 'The board hit an error updating (' + (e && e.message ? e.message : 'unknown') + '). Your tap was still recorded — tap Backup picks now, then Reset + Restore to redraw cleanly.';
    banner.style.display = 'block';
  }
}

function renderRoster(){
  const mineNames = Object.entries(state).filter(([k,v])=>v==='mine').map(([k])=>k);
  const mine = mineNames.map(n => all.find(p=>p[1]===n)).filter(Boolean);

  const slots = {QB:null, RB1:null, RB2:null, WR1:null, WR2:null, TE:null, WRT:null, FLEXQ:null, K:null, DEF:null};
  const bench = [];
  const used = new Set();

  const take = (pred) => {
    const idx = mine.findIndex((p,i)=> !used.has(i) && pred(p));
    if(idx>=0){ used.add(idx); return mine[idx]; }
    return null;
  };

  slots.QB = take(p=>p[3]==='QB');
  slots.RB1 = take(p=>p[3]==='RB');
  slots.RB2 = take(p=>p[3]==='RB');
  slots.WR1 = take(p=>p[3]==='WR');
  slots.WR2 = take(p=>p[3]==='WR');
  slots.TE = take(p=>p[3]==='TE');
  slots.K = take(p=>p[3]==='K');
  slots.DEF = take(p=>p[3]==='DEF');
  slots.WRT = take(p=>['WR','RB','TE'].includes(p[3]));
  slots.FLEXQ = take(p=>['WR','TE','QB'].includes(p[3]));

  mine.forEach((p,i)=>{ if(!used.has(i)) bench.push(p); });

  const labelMap = {QB:'QB',RB1:'RB',RB2:'RB',WR1:'WR',WR2:'WR',TE:'TE',WRT:'WR/RB/TE',FLEXQ:'WR/TE/QB',K:'K',DEF:'DEF'};
  const el = document.getElementById('slotList');
  el.innerHTML = '';
  Object.keys(labelMap).forEach(key=>{
    const p = slots[key];
    const row = document.createElement('div');
    row.className = 'slot-row';
    row.innerHTML = `<div class="slot-tag">${labelMap[key]}</div><div class="${p?'slot-filled':'slot-empty'}">${p ? p[1]+' · '+p[2] : 'Empty'}</div>`;
    el.appendChild(row);
  });
  if(bench.length){
    const row = document.createElement('div');
    row.className = 'slot-row';
    row.innerHTML = `<div class="slot-tag">BENCH</div><div class="slot-filled">${bench.map(p=>p[1]).join(', ')}</div>`;
    el.appendChild(row);
  }
}

document.getElementById('filterRow').addEventListener('click', (e)=>{
  const chip = e.target.closest('.chip');
  if(!chip) return;
  document.querySelectorAll('#filterRow .chip').forEach(c=>c.classList.remove('active'));
  chip.classList.add('active');
  currentFilter = chip.dataset.f;
  render();
});

document.getElementById('sortRow').addEventListener('click', (e)=>{
  const chip = e.target.closest('.chip');
  if(!chip) return;
  if(chip.id === 'hideDraftedChip'){
    hideDrafted = !hideDrafted;
    chip.classList.toggle('active', hideDrafted);
    chip.textContent = hideDrafted ? '✓ Hide drafted' : '☐ Hide drafted';
    render();
    return;
  }
  document.querySelectorAll('#sortRow .chip[data-s]').forEach(c=>c.classList.remove('active'));
  chip.classList.add('active');
  sortMode = chip.dataset.s;
  render();
});

document.getElementById('searchBox').addEventListener('input', (e)=>{
  searchTerm = e.target.value;
  render();
});

document.getElementById('rosterToggle').addEventListener('click', ()=>{
  document.getElementById('rosterPanel').classList.toggle('open');
});

function hideAllUtilityPanels(){
  ['backupPanel','restorePanel','resetConfirmPanel'].forEach(id=>{
    document.getElementById(id).style.display = 'none';
  });
}

document.getElementById('backupBtn').addEventListener('click', ()=>{
  hideAllUtilityPanels();
  const code = encodeState();
  const ta = document.getElementById('backupText');
  ta.value = code;
  document.getElementById('backupCopyMsg').textContent = '';
  document.getElementById('backupPanel').style.display = 'block';
  ta.focus();
  ta.select();
});

document.getElementById('backupCopyBtn').addEventListener('click', async ()=>{
  const msg = document.getElementById('backupCopyMsg');
  const ta = document.getElementById('backupText');
  ta.focus();
  ta.select();
  try{
    if(navigator.clipboard && navigator.clipboard.writeText){
      await navigator.clipboard.writeText(ta.value);
      msg.textContent = 'Copied.';
      msg.style.color = 'var(--mine)';
    } else {
      throw new Error('no clipboard API');
    }
  }catch(e){
    msg.textContent = 'Auto-copy blocked here — the text above is already selected, use your normal copy gesture (Cmd/Ctrl+C, or long-press → Copy).';
    msg.style.color = 'var(--muted)';
  }
});

document.getElementById('backupCloseBtn').addEventListener('click', hideAllUtilityPanels);

document.getElementById('restoreBtn').addEventListener('click', ()=>{
  hideAllUtilityPanels();
  document.getElementById('restoreText').value = '';
  document.getElementById('restoreMsg').textContent = '';
  document.getElementById('restorePanel').style.display = 'block';
  document.getElementById('restoreText').focus();
});

document.getElementById('restoreCloseBtn').addEventListener('click', hideAllUtilityPanels);

document.getElementById('restoreLoadBtn').addEventListener('click', ()=>{
  const code = document.getElementById('restoreText').value;
  const msg = document.getElementById('restoreMsg');
  if(!code.trim()){
    msg.textContent = 'Paste a backup code first.';
    msg.style.color = '#FF8A8A';
    return;
  }
  try{
    const restored = decodeState(code);
    state = restored;
    saveState();
    render();
    msg.textContent = 'Restored ' + Object.keys(state).length + ' tracked picks.';
    msg.style.color = 'var(--mine)';
    setTimeout(hideAllUtilityPanels, 1200);
  }catch(e){
    msg.textContent = "That code didn't parse — double-check you copied the whole string.";
    msg.style.color = '#FF8A8A';
  }
});

function doReset(){
  hideAllUtilityPanels();
  document.getElementById('resetConfirmPanel').style.display = 'block';
}
document.getElementById('resetBtn').addEventListener('click', doReset);
document.getElementById('resetBtnTop').addEventListener('click', doReset);

document.getElementById('resetConfirmNo').addEventListener('click', hideAllUtilityPanels);
document.getElementById('resetConfirmYes').addEventListener('click', async ()=>{
  state = {};
  await saveState();
  render();
  hideAllUtilityPanels();
});

document.getElementById('undoBtn').addEventListener('click', ()=>{
  if(!lastAction) return;
  const { name, prev } = lastAction;
  if(prev === undefined || prev === null){ delete state[name]; }
  else { state[name] = prev; }
  lastAction = null;
  saveState();
  render();
});

// Floating jump-to-top: only show once scrolled past the header, so it's out of the way early on
const jumpBtn = document.getElementById('jumpTopBtn');
window.addEventListener('scroll', ()=>{
  jumpBtn.style.display = window.scrollY > 300 ? 'block' : 'none';
}, { passive: true });
jumpBtn.addEventListener('click', ()=>{
  window.scrollTo({ top: 0, behavior: 'smooth' });
});

(async function init(){
  await loadState();
  render();
})();
</script>
