<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Hog Market Draft Tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0A0E1A;
    --surface:#121829;
    --surface2:#182036;
    --border:#232D48;
    --text:#E8ECF4;
    --muted:#7C8AA8;
    --amber:#F2B84B;
    --amber-dim:#4A3B1E;
    --qb:#FF6B6B;
    --rb:#4ADE80;
    --wr:#5DADE2;
    --te:#F5A623;
    --def:#B48EF0;
    --k:#94A3B8;
    --mine:#2FD07A;
    --gone:#3A4258;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color: transparent;}
  body{
    margin:0; background:var(--bg); color:var(--text);
    font-family:'Inter',system-ui,sans-serif;
    padding-bottom:40px;
  }
  h1,h2,.display{font-family:'Oswald',sans-serif; text-transform:uppercase; letter-spacing:0.02em;}
  .mono{font-family:'JetBrains Mono',monospace;}

  /* Top scoreboard bar */
  .scoreboard{
    position:sticky; top:0; z-index:20;
    background:linear-gradient(180deg, #10162A 0%, #0D1220 100%);
    border-bottom:1px solid var(--border);
    padding:10px 14px 8px;
  }
  .sb-row{display:flex; align-items:center; justify-content:space-between; gap:10px;}
  .sb-title{font-size:13px; font-weight:600; color:var(--muted); letter-spacing:0.08em;}
  .sb-title b{color:var(--text);}
  .pick-badge{
    display:flex; align-items:center; gap:8px;
    background:var(--surface2); border:1px solid var(--border);
    border-radius:10px; padding:6px 12px;
  }
  .pick-badge .num{font-family:'JetBrains Mono',monospace; font-weight:700; font-size:18px;}
  .pick-badge .lbl{font-size:10px; color:var(--muted); text-transform:uppercase; letter-spacing:0.08em;}
  .on-clock{
    animation:pulse 1.4s ease-in-out infinite;
    background:var(--amber-dim) !important; border-color:var(--amber) !important;
  }
  .on-clock .num{color:var(--amber);}
  @keyframes pulse{ 0%,100%{box-shadow:0 0 0 0 rgba(242,184,75,0.35);} 50%{box-shadow:0 0 0 6px rgba(242,184,75,0);} }

  .countdown-strip{
    margin-top:8px; font-size:12px; color:var(--muted); display:flex; gap:14px; flex-wrap:wrap;
  }
  .countdown-strip .hl{color:var(--text); font-weight:600;}

  /* Filters */
  .filters{
    display:flex; gap:6px; overflow-x:auto; padding:10px 14px 4px;
    background:var(--bg); position:sticky; top:64px; z-index:19;
    border-bottom:1px solid var(--border);
  }
  #sortRow{ top:108px; z-index:18; }
  .filters::-webkit-scrollbar{display:none;}
  .chip{
    flex:0 0 auto; padding:6px 12px; border-radius:999px; font-size:12px; font-weight:600;
    border:1px solid var(--border); background:var(--surface); color:var(--muted); cursor:pointer;
  }
  .chip.active{background:var(--text); color:var(--bg); border-color:var(--text);}
  .search-row{padding:8px 14px; display:flex; gap:8px;}
  .search-row input{
    flex:1; background:var(--surface); border:1px solid var(--border); border-radius:8px;
    padding:9px 12px; color:var(--text); font-size:14px; font-family:'Inter',sans-serif;
  }
  .search-row input:focus{outline:none; border-color:var(--amber);}
  .toggle-btn{
    background:var(--surface2); border:1px solid var(--border); color:var(--text);
    border-radius:8px; padding:9px 14px; font-size:12px; font-weight:600; cursor:pointer; white-space:nowrap;
  }

  /* Roster panel */
  .roster-panel{
    margin:0 14px 10px; background:var(--surface); border:1px solid var(--border);
    border-radius:12px; padding:12px; display:none;
  }
  .roster-panel.open{display:block;}
  .roster-panel h2{font-size:15px; margin:0 0 8px;}
  .slot-row{
    display:flex; align-items:center; gap:8px; padding:6px 0; border-bottom:1px solid var(--border); font-size:13px;
  }
  .slot-row:last-child{border-bottom:none;}
  .slot-tag{
    flex:0 0 54px; font-size:10px; font-weight:700; color:var(--muted); text-transform:uppercase;
  }
  .slot-filled{color:var(--text); font-weight:600;}
  .slot-empty{color:var(--muted); font-style:italic;}

  /* Player list */
  .list{padding:6px 10px 20px;}
  .row{
    display:flex; align-items:center; gap:10px;
    background:var(--surface); border:1px solid var(--border); border-radius:10px;
    padding:10px 12px; margin-bottom:6px; cursor:pointer; user-select:none;
    transition:opacity .15s, transform .1s;
  }
  .row:active{transform:scale(0.99);}
  .row.gone{opacity:0.38;}
  .row.mine{border-color:var(--mine); background:#0F2318;}
  .rank{
    font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--muted); width:28px; text-align:right; flex:0 0 28px;
  }
  .pos-pill{
    flex:0 0 34px; text-align:center; font-size:11px; font-weight:700; border-radius:6px; padding:3px 0;
    font-family:'Oswald',sans-serif;
  }
  .pinfo{flex:1; min-width:0;}
  .pname{font-size:14px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
  .pname.gone-strike{text-decoration:line-through; text-decoration-color:var(--gone);}
  .pteam{font-size:11px; color:var(--muted);}
  .flag{
    font-size:9px; font-weight:700; padding:2px 6px; border-radius:5px; margin-left:6px; letter-spacing:0.03em;
  }
  .flag.holdin{background:#3A2E12; color:var(--amber);}
  .flag.injury{background:#3A1414; color:#FF8A8A;}
  .status-dot{flex:0 0 20px; text-align:center; font-size:16px;}
  .mine-btn{
    flex:0 0 auto; padding:8px 10px; border-radius:8px; font-size:11px; font-weight:700;
    font-family:'Oswald',sans-serif; letter-spacing:0.03em;
    border:1px solid var(--border); background:var(--surface2); color:var(--muted); cursor:pointer;
    min-width:52px;
  }
  .mine-btn.active{ background:var(--mine); color:#0A0E1A; border-color:var(--mine); }

  .section-note{
    padding:10px 16px; font-size:12px; color:var(--muted); line-height:1.5;
  }
  .footer-note{
    padding:16px; font-size:11px; color:var(--muted); border-top:1px solid var(--border); margin-top:10px; line-height:1.6;
  }
  .reset-btn{
    background:transparent; border:1px solid #5A2323; color:#FF8A8A; border-radius:8px;
    padding:8px 14px; font-size:12px; font-weight:600; cursor:pointer; margin-top:8px;
  }
</style>
</head>
