  <button class="toggle-btn" id="resetBtnTop" style="flex:0 0 auto; color:#FF8A8A; border-color:#5A2323;">↺ Reset</button>
</div>
<div id="storageWarning" style="display:none; margin:0 14px 8px; padding:8px 12px; background:#3A1414; border:1px solid #5A2323; border-radius:8px; font-size:11px; color:#FF8A8A; line-height:1.5;">
